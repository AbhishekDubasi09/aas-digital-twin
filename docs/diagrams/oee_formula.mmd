flowchart LR
    T["planned time = now - gateway start"] --> RT["run time = planned - downtime"]
    D["downtime\n(sum of poll gaps while state is DOWN)"] --> RT
    RT --> A["Availability A = run time / planned time"]
    N["total cycles"] --> P["Performance P = min(1, ideal 4.0 s x cycles / run time)"]
    RT --> P
    N --> Q["Quality Q = good cycles / total cycles"]
    G["good cycles"] --> Q
    A --> O["OEE = A x P x Q"]
    P --> O
    Q --> O
